<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Token-Prüfung für Azure Functions (dotnet-isolated) in Sentinel-Seed-Projekten: validiert Bearer-Tokens aus Entra ID für Browser, Custom Connector und Dienste und löst App-Rollen in Capabilities auf.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>$(PackageTags);entra-id;authentication</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.51.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bfs.Seed.Auth.Tests" />
  </ItemGroup>

  <!--
    Analyzer (SEEDAUTH*, SEEDSUPPRESS*): kein eigenes Paket, sondern unter analyzers/dotnet/cs in
    diesem Paket. So wirkt er in jedem Projekt, das Bfs.Seed.Auth referenziert, auch über Bfs.Seed.Mcp.
    Die Referenz baut ihn vorher und lässt ihn auch über den Code dieses Pakets laufen; sie ist keine
    Abhängigkeit des Pakets.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Bfs.Seed.Analyzers\Bfs.Seed.Analyzers.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_SeedPackAnalyzer</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_SeedPackAnalyzer">
    <MSBuild Projects="..\Bfs.Seed.Analyzers\Bfs.Seed.Analyzers.csproj" Targets="GetTargetPath" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" PropertyName="_SeedAnalyzerPath" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_SeedAnalyzerPath)" PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
  </Target>

</Project>
