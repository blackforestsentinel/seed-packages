<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>MCP-Server für Azure Functions (dotnet-isolated) in Sentinel-Seed-Projekten: Endpunkt /api/mcp (Streamable HTTP, zustandslos), Metadaten nach RFC 9728, Werkzeuge per Attribut mit Capabilities aus Bfs.Seed.Auth.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>$(PackageTags);mcp;model-context-protocol;entra-id</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.51.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

  <!--
    PrivateAssets ohne analyzers: Der Analyzer aus Bfs.Seed.Auth soll auch in Projekten wirken, die nur
    Bfs.Seed.Mcp referenzieren. Mit dem Standard stünde in der Abhängigkeit exclude="Build,Analyzers".
  -->
  <ItemGroup>
    <ProjectReference Include="..\Bfs.Seed.Auth\Bfs.Seed.Auth.csproj" PrivateAssets="contentfiles;build" />
  </ItemGroup>

  <!-- Dieselben Regeln für die Functions dieses Pakets (SeedMcp, SeedMcpResourceMetadata). -->
  <ItemGroup>
    <ProjectReference Include="..\Bfs.Seed.Analyzers\Bfs.Seed.Analyzers.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bfs.Seed.Mcp.Tests" />
  </ItemGroup>

</Project>
