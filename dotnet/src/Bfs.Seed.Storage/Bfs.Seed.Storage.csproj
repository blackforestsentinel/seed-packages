<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Datenhaltung für Azure Functions (dotnet-isolated) in Sentinel-Seed-Projekten: Clients für Table, Blob und Queue per Managed Identity oder Azurite, Table-Repository mit ETag, Partitionen je Person oder Tenant.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>$(PackageTags);azure-storage;table-storage;queue-storage</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.28.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.51.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bfs.Seed.Storage.Tests" />
  </ItemGroup>

</Project>
