<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Paket-Metadaten. Die Version setzt die Release-Pipeline aus dem Git-Tag. -->
  <PropertyGroup>
    <Version>0.0.0-dev</Version>
    <Authors>Black Forest Sentinel</Authors>
    <Company>Black Forest Sentinel</Company>
    <Product>Sentinel Seed</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/blackforestsentinel/seed-packages</PackageProjectUrl>
    <RepositoryUrl>https://github.com/blackforestsentinel/seed-packages.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>sentinel-seed;azure-functions</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
