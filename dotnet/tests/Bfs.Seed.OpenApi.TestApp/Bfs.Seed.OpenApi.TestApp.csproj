<Project Sdk="Microsoft.NET.Sdk">

  <!--
    App-Assembly für die Tests von Bfs.Seed.OpenApi: HTTP-Functions mit Attributen, eine
    Queue-Function, Typen mit XML-Doku. Keine lauffähige Function-App (kein Worker-SDK);
    der Generator braucht nur die Attribute.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <!-- Der Generator schneidet den Anhang nach + ab. -->
    <Version>1.2.3-test</Version>
    <InformationalVersion>1.2.3-test+0123abc</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.51.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bfs.Seed.Mcp\Bfs.Seed.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Bfs.Seed.OpenApi\Bfs.Seed.OpenApi.csproj" />
  </ItemGroup>

</Project>
